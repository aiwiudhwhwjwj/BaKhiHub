local BABTab = Window:CreateTab("⛵ Build A Boat", nil)

_G.AutoFarm = false
_G.TweenSpeed = 100
_G.CurrentTween = nil

BABTab:CreateSlider({
   Name = "Tween Speed",
   Range = {10, 750},
   Increment = 10,
   Suffix = "Studs/s",
   CurrentValue = 100,
   Flag = "tweenspeed_bab",
   Callback = function(Value)
      _G.TweenSpeed = Value
   end,
})

local function tweenAndHover(targetCFrame)
   local TweenService = game:GetService("TweenService")
   local Players = game:GetService("Players")
   local player = Players.LocalPlayer
   local character = player.Character
   if not character then return false end
   local hrp = character:FindFirstChild("HumanoidRootPart")
   local humanoid = character:FindFirstChildOfClass("Humanoid")

   if not hrp or not humanoid or humanoid.Health <= 0 or not _G.AutoFarm then return false end

   local tweenSpeed = _G.TweenSpeed or 100
   local distance = (hrp.Position - targetCFrame.Position).Magnitude
   local duration = distance / tweenSpeed
   local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)

   _G.CurrentTween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
   _G.CurrentTween:Play()
   
   local elapsed = 0
   while elapsed < duration and _G.AutoFarm and humanoid.Health > 0 do
      task.wait(0.1)
      elapsed = elapsed + 0.1
   end

   if not _G.AutoFarm or humanoid.Health <= 0 then
      if _G.CurrentTween then _G.CurrentTween:Cancel() end
      return false
   end

   local waitElapsed = 0
   while waitElapsed < 1.5 and _G.AutoFarm and humanoid.Health > 0 do
      task.wait(0.1)
      waitElapsed = waitElapsed + 0.1
   end

   if not _G.AutoFarm or humanoid.Health <= 0 then
      return false
   end

   return true
end

local Toggle = BABTab:CreateToggle({
   Name = "Farm tự động",
   CurrentValue = false,
   Flag = "AutoFarmBAB",
   Callback = function(Value)
      _G.AutoFarm = Value
      
      local Players = game:GetService("Players")
      local player = Players.LocalPlayer

      if _G.AutoFarm then
         task.spawn(function()
            while _G.AutoFarm do
               local character = player.Character or player.CharacterAdded:Wait()
               local hrp = character:WaitForChild("HumanoidRootPart", 10)
               local humanoid = character:WaitForChild("Humanoid", 10)
               
               if hrp and humanoid and humanoid.Health > 0 then
                  local bv = Instance.new("BodyVelocity")
                  bv.Name = "FarmHoverVelocity"
                  bv.Velocity = Vector3.new(0, 0, 0)
                  bv.MaxForce = Vector3.new(0, math.huge, 0)
                  bv.Parent = hrp

                  local targetX = -50
                  local defaultY = 65

                  local zList = {1005, 1725, 2550, 3330, 4050, 4850, 5625, 6350, 7215, 8000, 8684, 9490}

                  for i, zVal in ipairs(zList) do
                     if not _G.AutoFarm or humanoid.Health <= 0 then break end
                     
                     local currentY = (i == #zList) and -360 or defaultY
                     
                     local success = tweenAndHover(CFrame.new(targetX, currentY, zVal))
                     if not success then break end
                  end

                  if bv and bv.Parent then 
                     bv:Destroy() 
                  end

                  if _G.AutoFarm then
                     player.CharacterAdded:Wait()
                     task.wait(1)
                  end
               end
            end
         end)
      else
         if _G.CurrentTween then
            _G.CurrentTween:Cancel()
            _G.CurrentTween = nil
         end

         local character = player.Character
         if character and character:FindFirstChild("HumanoidRootPart") then
            local bv = character.HumanoidRootPart:FindFirstChild("FarmHoverVelocity")
            if bv then bv:Destroy() end
         end
      end
   end,
})

